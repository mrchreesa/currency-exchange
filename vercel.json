{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/delivery-worker.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "reservation-delivery"
        }
      ]
    }
  }
}
