{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "currency-exchange-quick-stop.vercel.app"
        }
      ],
      "destination": "https://quickcurrencyexchange.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(lib|docs|test|api)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(md|json)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/delivery-worker.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "reservation-delivery"
        }
      ]
    }
  }
}
